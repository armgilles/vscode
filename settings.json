{
    "workbench.colorTheme": "Dark+",
    "terminal.integrated.inheritEnv": false,
    "jupyter.askForKernelRestart": false,
    // From https://stackoverflow.com/a/70758108
    "workbench.colorCustomizations": {
        "terminal.ansiYellow": "#8400ffe1",
        "statusBar.background": "#8FBCBB",
        "statusBar.noFolderBackground": "#8FBCBB",
        "statusBar.debuggingBackground": "#8FBCBB",
        "statusBar.foreground": "#434C5E",
        "statusBar.debuggingForeground": "#434C5E",
        // to higtlight current line border
        "editor.lineHighlightBorder": "#d45ccab0"
    },
    "editor.renderLineHighlight": "all",
    "notebook.output.textLineLimit": 1100,
    "python.analysis.completeFunctionParens": true,
    "autoDocstring.startOnNewLine": true,
    "autoDocstring.docstringFormat": "numpy",
    "editor.cursorStyle": "block",
    "[python]": {
        "editor.formatOnType": true,
        "editor.defaultFormatter": "charliermarsh.ruff"
    },
    "window.zoomLevel": -1,
    "editor.fontSize": 14,
    "editor.fontFamily": "Menlo",
    "git.ignoreLegacyWarning": true,
    "editor.inlineSuggest.enabled": true,
    "terminal.integrated.defaultProfile.linux": "bash",
    "sonarlint.focusOnNewCode": true,
    "update.mode": "manual",
    "editor.cursorSurroundingLines": 15,
    // with Go to Next/Previous Member extension
    "gotoNextPreviousMember.symbolKinds": [
        "function",
        "class",
        "method"
    ],
    "editor.smoothScrolling": true,
    "editor.cursorSmoothCaretAnimation": "on",
    "settingsSync.ignoredExtensions": [
        "ms-toolsai.jupyter"
    ],
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": "active",
    //VIM
    "vim.easymotion": true,
    "vim.incsearch": true,
    "vim.useSystemClipboard": true,
    "vim.useCtrlKeys": true,
    "vim.hlsearch": false,
    "vim.highlightedyank.enable": true,
    "vim.cursorStylePerMode.insert": "line-thin",
    "vim.cursorStylePerMode.normal": "block",
    "vim.cursorStylePerMode.visual": "underline",
    "flash-vscode.labelKeys": "aeicltnsuogdp.mvbqfzhykwj",
    //Vim color
    "vim.statusBarColorControl": false,
    "vim.statusBarColors.normal": [
        "#8FBCBB",
        "#434C5E"
    ],
    "vim.statusBarColors.insert": "#BF616A",
    "vim.statusBarColors.visual": "#B48EAD",
    "vim.statusBarColors.visualline": "#B48EAD",
    "vim.statusBarColors.visualblock": "#A3BE8C",
    "vim.statusBarColors.replace": "#D08770",
    "vim.statusBarColors.commandlineinprogress": "#007ACC",
    "vim.statusBarColors.searchinprogressmode": "#007ACC",
    "vim.statusBarColors.easymotionmode": "#007ACC",
    "vim.statusBarColors.easymotioninputmode": "#007ACC",
    "vim.statusBarColors.surroundinputmode": "#007ACC",
    // To use target vim with cia, daa etc...
    "vim.argumentObjectClosingDelimiters": [
        ")",
        "]",
        "}"
    ],
    "vim.argumentObjectOpeningDelimiters": [
        "(",
        "[",
        "{"
    ],
    // Gestion de la jumplist de vim
    // https://github.com/VSCodeVim/Vim/issues/8317#issuecomment-1592953138
    // On a le choix entre : 
    // - "workbench.action.navigateBack" et "workbench.action.navigateForward" pour tout la navigation et modif.
    // - "workbench.action.navigateBackInEditLocations" et "workbench.action.navigateForwardInEditLocations" pour l'édition seulement
    // - "workbench.action.navigateBackInNavigationLocations" et "workbench.action.navigateForwardInNavigationLocations" pour la navigation seulement
    // À noter que l'on peut joueur avec le setting "workbench.editor.navigationScope" pour changer le scope de la navigation
    "vim.normalModeKeyBindings": [
        // Edit : Now use classic keybinding in keybindings.json
        // {
        //     "before": [
        //         "<C-o>"
        //     ],
        //     "commands": [
        //         "workbench.action.navigateBack"
        //     ]
        // },
        // {
        //     "before": [
        //         "<C-i>"
        //     ],
        //     "commands": [
        //         "workbench.action.navigateForward"
        //     ]
        // }
        {
            "before": [
                "'"
            ],
            "after": [
                "w"
            ]
        }
    ],
    "vim.insertModeKeyBindings": [
        {
            "before": [
                "j",
                "j"
            ],
            "after": [
                "<Esc>"
            ]
        }
    ],
    "vim.normalModeKeyBindingsNonRecursive": [
        // Permets de faire un retour a la ligne sans passer par le mode insert
        {
            "before": [
                "T"
            ],
            "after": [
                "$",
                "a",
                "<CR>",
                "<Esc>"
            ],
            "silent": true
        },
        // Permets de fusionner la ligne actuelle et celle du dessous sans ajouter d'espace
        {
            "before": [
                "L"
            ],
            "after": [
                "g",
                "J"
            ]
        },
        {
            "before": [
                "<C-n>"
            ],
            "after": [],
            "commands": [
                {
                    "command": ":nohl"
                }
            ]
        },
        // to disable copy when delete
        {
            "before": [
                "d"
            ],
            "after": [
                "\"",
                "_",
                "d"
            ]
        },
        {
            "before": [
                "D"
            ],
            "after": [
                "\"",
                "_",
                "D"
            ]
        },
        {
            "before": [
                "d",
                "d"
            ],
            "after": [
                "\"",
                "_",
                "d",
                "d"
            ]
        },
        {
            "before": [
                "<BS>"
            ],
            "after": [
                "\"",
                "_",
                "d"
            ]
        },
        {
            "before": [
                "c"
            ],
            "after": [
                "\"",
                "_",
                "c"
            ]
        },
        {
            "before": [
                "C"
            ],
            "after": [
                "\"",
                "_",
                "C"
            ]
        },
        {
            "before": [
                "x"
            ],
            "after": [
                "\"",
                "_",
                "x"
            ]
        },
        {
            "before": [
                "s"
            ],
            "after": [
                "\"",
                "_",
                "s"
            ]
        },
        // Permet d'utiliser Y commt y$
        {
            "before": [
                "Y"
            ],
            "after": [
                "y",
                "$"
            ]
        },
        // remaper "<C-w>" pour la gestion des switch windows sans passer par "<C-w>"
        {
            "before": [
                "<C-e>"
            ],
            "after": [
                "<C-w>"
            ]
        },
        // panes navigation
        {
            "before": [
                "<C-w>",
                "h"
            ],
            "commands": [
                "workbench.action.focusLeftGroup"
            ]
        },
        {
            "before": [
                "<C-w>",
                "j"
            ],
            "commands": [
                "workbench.action.focusBelowGroup"
            ]
        },
        {
            "before": [
                "<C-w>",
                "k"
            ],
            "commands": [
                "workbench.action.focusAboveGroup"
            ]
        },
        {
            "before": [
                "<C-w>",
                "l"
            ],
            "commands": [
                "workbench.action.focusRightGroup"
            ]
        },
        // to move screen down one line
        {
            "before": [
                "<C-h>"
            ],
            "after": [
                "<C-e>"
            ]
        },
        // Remap de gr -> gxx
        {
            "before": [
                "g",
                "i",
                "w"
            ],
            "after": [
                "g",
                "r",
                "i",
                "w"
            ]
        },
        // gia == giw
        {
            "before": [
                "g",
                "i",
                "a"
            ],
            "after": [
                "g",
                "r",
                "i",
                "w"
            ]
        },
        {
            "before": [
                "g",
                "i",
                "p"
            ],
            "after": [
                "g",
                "r",
                "i",
                "p"
            ]
        },
        // Problème avec cette motion suivant ou on la lance
        // Si entre des "alors la position du cursor est OK.
        // Si on la lance en début de ligne, le cursor se met plus loin qu'il faudrais.
        {
            "before": [
                "g",
                "i",
                "\""
            ],
            "after": [
                "\"",
                "_",
                "c",
                "i",
                "\"",
                "ESC",
                "p",
                "ESC"
            ]
        },
        // " = r
        {
            "before": [
                "g",
                "i",
                "r"
            ],
            "after": [
                "\"",
                "_",
                "c",
                "i",
                "\"",
                "ESC",
                "p",
                "ESC"
            ]
        },
        {
            "before": [
                "g",
                "a",
                "w"
            ],
            "after": [
                "g",
                "r",
                "a",
                "w"
            ]
        },
        {
            "before": [
                "g",
                "i",
                "p"
            ],
            "after": [
                "g",
                "r",
                "i",
                "p"
            ]
        },
        // []
        {
            "before": [
                "g",
                "i",
                "["
            ],
            "after": [
                "g",
                "r",
                "i",
                "["
            ]
        },
        {
            "before": [
                "g",
                "i",
                "]"
            ],
            "after": [
                "g",
                "r",
                "i",
                "]"
            ]
        },
        // [ -> s
        {
            "before": [
                "g",
                "i",
                "s"
            ],
            "after": [
                "g",
                "r",
                "i",
                "["
            ]
        },
        {
            "before": [
                "g",
                "a",
                "["
            ],
            "after": [
                "g",
                "r",
                "a",
                "["
            ]
        },
        {
            "before": [
                "g",
                "a",
                "]"
            ],
            "after": [
                "g",
                "r",
                "a",
                "]"
            ]
        },
        // [ -> s
        {
            "before": [
                "g",
                "a",
                "s"
            ],
            "after": [
                "g",
                "r",
                "a",
                "["
            ]
        },
        // ()
        {
            "before": [
                "g",
                "i",
                "("
            ],
            "after": [
                "g",
                "r",
                "i",
                "("
            ]
        },
        {
            "before": [
                "g",
                "i",
                ")"
            ],
            "after": [
                "g",
                "r",
                "i",
                ")"
            ]
        },
        // ( -> b
        {
            "before": [
                "g",
                "i",
                "b"
            ],
            "after": [
                "g",
                "r",
                "i",
                "("
            ]
        },
        {
            "before": [
                "g",
                "a",
                "("
            ],
            "after": [
                "g",
                "r",
                "a",
                "("
            ]
        },
        {
            "before": [
                "g",
                "a",
                ")"
            ],
            "after": [
                "g",
                "r",
                "a",
                ")"
            ]
        },
        // ( -> b
        {
            "before": [
                "g",
                "a",
                "b"
            ],
            "after": [
                "g",
                "r",
                "a",
                "("
            ]
        },
        {
            "before": [
                "f"
            ],
            "commands": [
                "flash-vscode.start"
            ]
        },
        // "
        {
            "before": [
                "g",
                "i",
                "\""
            ],
            "after": [
                "g",
                "r",
                "i",
                "\""
            ]
        },
        {
            "before": [
                "g",
                "a",
                "\""
            ],
            "after": [
                "g",
                "r",
                "a",
                "\""
            ]
        },
        {
            "before": [
                "f"
            ],
            "commands": [
                "flash-vscode.start"
            ]
        },
        {
            "before": [
                "F"
            ],
            "commands": [
                "flash-vscode.startSelection"
            ]
        },
        {
            "before": [
                "<BS>"
            ],
            "commands": [
                "flash-vscode.backspace"
            ]
        },
        // using cg instead of *cgn (replace word) then "." or "j" to replace multiple
        // using #* to stay on the curent work and still use j & J is the right way
        // So use cg then "." or "j" to move to the next occurence and choose again "." or "j"
        {
            "before": [
                "c",
                "g"
            ],
            "after": [
                "#",
                "*",
                "\"",
                "_",
                "c",
                "g",
                "n"
            ]
        },
        // Permet d'avoir cp / dp (change paragraph / delete paragraph) and yank etc ...
        {
            "before": [
                "d",
                "p"
            ],
            "after": [
                "\"",
                "_",
                "d",
                "}"
            ]
        },
        {
            "before": [
                "c",
                "p"
            ],
            "after": [
                "\"",
                "_",
                "c",
                "}"
            ]
        },
        {
            "before": [
                "y",
                "p"
            ],
            "after": [
                "y",
                "}"
            ]
        },
        {
            "before": [
                "v",
                "p"
            ],
            "after": [
                "v",
                "}"
            ]
        },
        {
            "before": [
                "g",
                "p"
            ],
            "after": [
                // "\"",
                // "_",
                "g",
                "r",
                "}"
            ]
        },
        // remap HJKL whit EnthiumFr layout
        {
            "before": [
                "j"
            ],
            "after": [
                "i"
            ]
        },
        {
            "before": [
                "k"
            ],
            "after": [
                "h"
            ]
        },
        {
            "before": [
                "l"
            ],
            "after": [
                "j"
            ]
        },
        {
            "before": [
                "t"
            ],
            "after": [
                "k"
            ]
        },
        {
            "before": [
                "n"
            ],
            "after": [
                "l"
            ]
        },
        // remap n -> "," for search next (and N -> "<" for search previous)
        // for cg custum motion
        {
            "before": [
                "j"
            ],
            "after": [
                "n"
            ]
        },
        {
            "before": [
                "J"
            ],
            "after": [
                "N"
            ]
        },
        // rg -> Replace line with copy
        {
            "before": [
                "r",
                "g"
            ],
            "after": [
                "\"",
                "_",
                "c",
                "c",
                "<Esc>",
                "p"
            ]
        },
        // remap dj / dk with EnthiumFr layout
        {
            "before": [
                "d",
                "l"
            ],
            "after": [
                "\"",
                "_",
                "d",
                "j"
            ]
        },
        {
            "before": [
                "d",
                "t"
            ],
            "after": [
                "\"",
                "_",
                "d",
                "k"
            ]
        },
        // via -> viw
        {
            "before": [
                "v",
                "i",
                "a"
            ],
            "after": [
                "v",
                "i",
                "w"
            ]
        },
        // vir -> vi"
        {
            "before": [
                "v",
                "i",
                "r"
            ],
            "after": [
                "v",
                "i",
                "\""
            ]
        },
        // var -> va"
        {
            "before": [
                "v",
                "a",
                "r"
            ],
            "after": [
                "v",
                "a",
                "\""
            ]
        }
    ],
