    // ne fonctionne pas pour l'onget jupyter & gitlens...
    {
        "key": "ctrl+e l",
        "command": "workbench.action.nextPanelView",
        "when": "panelFocus || focusedView == 'workbench.panel.testResults.view.focus'"
